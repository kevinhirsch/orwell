{
  "name": "orwell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Immersive single-player Big Brother simulation — hexagonal engine with a structural Vault Wall.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:fastembed --external:better-sqlite3 --external:sqlite-vec --outfile=dist/main.js && esbuild src/adapters/embedding/fastembedWorker.ts --bundle --platform=node --format=esm --target=node22 --external:fastembed --outfile=dist/embedWorker.js",
    "start": "node dist/main.js",
    "observatory": "NODE_OPTIONS='--import tsx' node tests/dev/societyObservatory.ts",
    "test:unit": "vitest run",
    "test:unit:fast": "vitest run --exclude 'tests/uat/**' --exclude 'tests/property/juryReach.property.test.ts' --exclude 'tests/property/juryReachAggregate.property.test.ts' --exclude 'tests/property/juryReachShowrunnerReweight.property.test.ts' --exclude 'tests/property/calibrationGradient.property.test.ts' --exclude 'tests/property/calibrationGradientAggregate.property.test.ts' --exclude 'tests/property/calibrationGradientShowrunnerReweight.property.test.ts' --exclude 'tests/calibration/**'",
    "test:heavy": "vitest run tests/uat/fullGameUat.12seed.test.ts tests/uat/fullGameUat.5seed.test.ts tests/uat/fullGameUat.decisions.test.ts tests/uat/fullGameUat.reweight.test.ts tests/property/juryReach.property.test.ts tests/property/juryReachShowrunnerReweight.property.test.ts tests/property/calibrationGradient.property.test.ts tests/property/calibrationGradientShowrunnerReweight.property.test.ts",
    "test:heavy:uat-12seed": "vitest run tests/uat/fullGameUat.12seed.test.ts",
    "test:heavy:uat-12seed-a": "UAT12_SHARDS=3 UAT12_SHARD=0 vitest run tests/uat/fullGameUat.12seed.test.ts",
    "test:heavy:uat-12seed-b": "UAT12_SHARDS=3 UAT12_SHARD=1 vitest run tests/uat/fullGameUat.12seed.test.ts",
    "test:heavy:uat-12seed-c": "UAT12_SHARDS=3 UAT12_SHARD=2 vitest run tests/uat/fullGameUat.12seed.test.ts",
    "test:heavy:uat-5seed": "vitest run tests/uat/fullGameUat.5seed.test.ts",
    "test:heavy:uat-decisions": "vitest run tests/uat/fullGameUat.decisions.test.ts",
    "test:heavy:jury": "vitest run tests/property/juryReach.property.test.ts",
    "test:heavy:jury:aggregate": "vitest run tests/property/juryReachAggregate.property.test.ts",
    "test:heavy:gradient": "vitest run tests/property/calibrationGradient.property.test.ts",
    "test:heavy:gradient:aggregate": "vitest run tests/property/calibrationGradientAggregate.property.test.ts",
    "test:heavy:jury-reweight": "vitest run tests/property/juryReachShowrunnerReweight.property.test.ts",
    "test:heavy:gradient-reweight": "vitest run tests/property/calibrationGradientShowrunnerReweight.property.test.ts",
    "test:heavy:uat-reweight": "vitest run tests/uat/fullGameUat.reweight.test.ts",
    "test:watch": "vitest",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:cov": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**' --coverage.exclude='src/ports/**' --coverage.exclude='src/main.ts' --exclude 'tests/uat/**' --exclude 'tests/property/juryReach.property.test.ts' --exclude 'tests/property/juryReachAggregate.property.test.ts' --exclude 'tests/property/juryReachShowrunnerReweight.property.test.ts' --exclude 'tests/property/calibrationGradient.property.test.ts' --exclude 'tests/property/calibrationGradientAggregate.property.test.ts' --exclude 'tests/property/calibrationGradientShowrunnerReweight.property.test.ts' --exclude 'tests/calibration/**'",
    "test": "npm run typecheck && npm run build && npm run test:unit && npm run test:bdd",
    "test:ci": "npm run typecheck && npm run build && npm run test:unit:fast && npm run test:bdd",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "^0.24.2",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "fastembed": "2.1.0",
    "patch-package": "^8.0.0",
    "sqlite-vec": "0.1.9"
  },
  "overrides": {
    "tar": "7.5.16",
    "onnxruntime-node": "1.24.2"
  }
}
