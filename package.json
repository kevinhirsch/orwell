{
  "name": "orwell",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Immersive single-player Big Brother simulation — hexagonal engine with a structural Vault Wall.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --external:fastembed --external:better-sqlite3 --external:sqlite-vec --outfile=dist/main.js && esbuild src/adapters/embedding/fastembedWorker.ts --bundle --platform=node --format=esm --target=node22 --external:fastembed --outfile=dist/embedWorker.js",
    "start": "node dist/main.js",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "NODE_OPTIONS='--import tsx' cucumber-js",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test:cov": "vitest run --coverage --coverage.provider=v8 --coverage.include='src/**' --coverage.exclude='src/ports/**' --coverage.exclude='src/main.ts'",
    "test": "npm run typecheck && npm run build && npm run test:unit && npm run test:bdd"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "^0.24.2",
    "fast-check": "^3.23.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "fastembed": "2.1.0",
    "sqlite-vec": "0.1.9"
  }
}
