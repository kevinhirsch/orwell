# Caddy reverse proxy for Orwell — feature 0067 / ADR 0007 (self-hosted VPS alternative, Option C).
#
# Auto-provisions + renews a Let's Encrypt certificate for the domain. Run on a PUBLIC VPS; reach
# the front-end either on this host (127.0.0.1:8080) or across WireGuard to the LXC so the origin
# opens no public ports. Only the front-end is ever proxied — the engine is engine-only and is
# never given a route here. The front-end port must match ORWELL_PORT (installer default 8080).
#
# Remember to run the FE public profile: ORWELL_PUBLIC=1, ALLOWED_HOSTS=<your-domain>,..., and
# SECURE_COOKIES=true (Caddy terminates TLS and forwards X-Forwarded-Proto=https).

your-domain.example, www.your-domain.example {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		-Server
	}

	# Throttle the login endpoint. Requires the caddy-ratelimit plugin:
	#   xcaddy build --with github.com/mholt/caddy-ratelimit
	# Drop this block if you build vanilla Caddy — the app keeps its own per-client-IP login throttle.
	# rate_limit {
	#     zone login {
	#         match  { path /api/auth/login }
	#         key    {remote_host}
	#         events 15
	#         window 1m
	#     }
	# }

	# Front-end on THIS host:
	reverse_proxy 127.0.0.1:8080
	# …or the front-end in the LXC reached over WireGuard (origin opens no public ports), e.g.:
	# reverse_proxy 10.10.0.2:8080
}
