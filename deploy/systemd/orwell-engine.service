[Unit]
Description=orwell engine (TypeScript hexagonal core + MCP server)
After=network.target

[Service]
Type=simple
# Least privilege (B72/ops A5): a dedicated system user + systemd sandboxing. The installer
# creates `orwell` and chowns the app + data dirs.
User=orwell
Group=orwell
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/orwell/data
# Hardening (audit E85): drop every capability, confine syscalls/sockets, deny kernel and
# personality fiddling, and create files private-by-default. MemoryDenyWriteExecute is
# deliberately OMITTED — Node's JIT needs W+X mappings.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
UMask=0077
WorkingDirectory=/opt/orwell
# Optional (B72/ops A10): a manual install that hasn't written .env yet must fail on the app's
# own terms, not on a missing EnvironmentFile.
EnvironmentFile=-/opt/orwell/data/.env
# Run node directly (no npm wrapper): npm wants a writable $HOME cache, which the sandbox denies.
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
