[Unit]
Description=orwell front-end (orwell — Python/FastAPI/uvicorn)
# Wants= (not Requires=): the FE boots and serves a DEGRADED game-down state when the engine is
# absent (the engine-status banner; reads fail open) — an engine crash must not take the UI down.
After=network.target orwell-engine.service
Wants=orwell-engine.service

[Service]
Type=simple
# Least privilege (B72/ops A5): same dedicated user + sandboxing as the engine.
User=orwell
Group=orwell
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/orwell/data /opt/orwell/frontend/data
# Hardening (audit E85): same posture as the engine unit. MemoryDenyWriteExecute is OMITTED —
# the ONNX runtime (fastembed) JIT-compiles kernels.
# Privileged ports: with the empty bounding set a non-root uvicorn cannot bind <1024. When
# ORWELL_PORT is below 1024 (e.g. 80), orwell-install.sh / orwell-update.sh write a drop-in
# (orwell-frontend.service.d/10-privileged-port.conf) granting exactly CAP_NET_BIND_SERVICE.
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
UMask=0077
WorkingDirectory=/opt/orwell/frontend
# Default port (audit E85): the EnvironmentFile is optional (-), so a box without data/.env must
# still expand ${ORWELL_PORT} — EnvironmentFile values override this default when present.
Environment=ORWELL_PORT=8080
# Bind LOOPBACK by default (feature 0067 / ADR 0007): on a public deploy the FE is reached by a
# LOCAL reverse proxy / tunnel connector (cloudflared, Caddy, Pangolin Newt) — NEVER the open
# network. Set ORWELL_BIND_HOST=0.0.0.0 in data/.env only for a deliberate trusted-LAN deploy
# with no proxy in front. The EnvironmentFile value overrides this default when present.
Environment=ORWELL_BIND_HOST=127.0.0.1
EnvironmentFile=-/opt/orwell/data/.env
# The orwell app reads ORWELL_ENGINE_MCP_URL (from the EnvironmentFile) to reach the engine's
# MCP server (frontend/INTEGRATION.md). The UI port comes from ORWELL_PORT.
# --proxy-headers + --forwarded-allow-ips: trust X-Forwarded-* ONLY from the local connector
# (127.0.0.1) so the app sees the real client scheme/IP behind the tunnel/proxy. For a VPS that
# proxies in over WireGuard, override the trusted IP to the proxy's address in the unit/.env.
# DEPLOY-15 (2026-07-05 ops-hygiene close-out): DO NOT add `--workers N` here. This process keeps
# several process-local module-level globals (_GAME_WAS_ACTIVE, _SESSION_GAME_FRAMED,
# _TIME_OF_DAY_APPLIED — see frontend/routes/chat_helpers.py's own comment block) that a
# multi-worker uvicorn would silently fragment: each worker gets its own independent copy, so a
# session framed by worker 1 looks unframed to worker 2, and each worker races to latch its own
# time-of-day re-apply. Single-process only — scale via more RAM/CPU for embeddings/portraits,
# never via `--workers`.
ExecStart=/opt/orwell/frontend/.venv/bin/uvicorn app:app --host ${ORWELL_BIND_HOST} --port ${ORWELL_PORT} --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
