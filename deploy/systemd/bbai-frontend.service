[Unit]
Description=bbai front-end (orwell — Python/FastAPI/uvicorn)
After=network.target bbai-engine.service
Wants=bbai-engine.service

[Service]
Type=simple
WorkingDirectory=/opt/bbai/frontend
EnvironmentFile=/opt/bbai/data/.env
# The orwell app reads BBAI_ENGINE_MCP_URL (from the EnvironmentFile) to reach the engine's
# MCP server (frontend/INTEGRATION.md). The UI port comes from BBAI_PORT.
ExecStart=/opt/bbai/frontend/.venv/bin/uvicorn app:app --host 0.0.0.0 --port ${BBAI_PORT}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
